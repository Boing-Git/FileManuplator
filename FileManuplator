#!/usr/bin/env bash

# Find the exact directory this script is living in
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Prepend our bundled 'bin' folder to the system PATH
# This forces engine.py to find our bundled ffmpeg/magick/pandoc FIRST
export PATH="$APP_DIR/bin:$PATH"

# Check if the user has PyGObject and GTK4 installed before launching
if ! python3 -c "import gi; gi.require_version('Gtk', '4.0')" &> /dev/null; then
    if [ -f /etc/os-release ] && grep -qi 'ID=nixos' /etc/os-release; then
        if [ -z "$IN_NIX_SHELL" ]; then
            echo "NixOS detected. Launching via nix-shell..."
            exec nix-shell "$APP_DIR/shell.nix" --run "\"$0\" $@"
        fi
    fi

    SCRIPT_PATH="$APP_DIR/scripts/install_dependencies.sh"
    if [ -t 1 ]; then
        echo "Dependencies missing. Installing them now..."
        bash "$SCRIPT_PATH"
        # Re-check after installation
        if ! python3 -c "import gi; gi.require_version('Gtk', '4.0')" &> /dev/null; then
            echo "Failed to install dependencies."
            exit 1
        fi
    else
        CMD="bash '$SCRIPT_PATH'; echo ''; read -p 'Press Enter to close...'"
        if command -v x-terminal-emulator >/dev/null; then
            x-terminal-emulator -e bash -c "$CMD"
        elif command -v gnome-terminal >/dev/null; then
            gnome-terminal -- bash -c "$CMD"
        elif command -v konsole >/dev/null; then
            konsole -e bash -c "$CMD"
        elif command -v xfce4-terminal >/dev/null; then
            xfce4-terminal -x bash -c "$CMD"
        elif command -v xterm >/dev/null; then
            xterm -e bash -c "$CMD"
        else
            echo "Could not find a terminal emulator. Please run $SCRIPT_PATH manually."
        fi
        exit 1
    fi
fi

# Launch the GTK app
exec python3 "$APP_DIR/src/gui.py" "$@"
